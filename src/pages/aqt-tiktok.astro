---
import BaseLayout from "../layouts/BaseLayout.astro";
import Stats from "src/components/Stats.astro";
import BlogCard from "src/components/BlogCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="lxb-linkedin">
  <div>
    <div class="text-center">
      <div class="text-3xl w-full font-bold mb-5">
        Auto Quote Tracker TikTok
      </div>
      <a href="https://www.tiktok.com/@autoquotetracker" target="_blank"
        ><img
          class="p-10"
          src="/aqt-tiktok.png"
          alt="Auto Quote Tracker TikTok Profile"
        /></a
      >
      <Stats
        stattitle1="Video views"
        stat1="15k"
        desc1="per month"
        stattitle2="Accounts reached"
        stat2="13.9k"
        desc2="per month"
      />
    </div>
    <div>
      <p>
        <b>Overview:</b>
        <br />
        As we aimed to increase shopping and sign-ups with Auto Quote Tracker, we
        launched a TikTok to raise brand awareness and drive traffic to the website.
      </p>
      <br />
      <p>
        We tested a variety of formats and content types to analyze performance
        and build a content calendar each week based on the results. Using this
        strategy, we built a repeatable process to batch create content and
        yield an average of 3k views per week within 5 months.
      </p>
    </div>
    <div class="pt-5">
      <p>
        <b>My responsibilities:</b>
        <ul>
          <li>
            • Review account analytics and social media trends on a weekly basis
            to inform planning
          </li>
          <li>• Build and execute a content calendar of 5 posts per week</li>
          <li>
            • Engage with commenters and other creators in the personal finance
            and auto spaces to increase brand reach
          </li>
        </ul>
      </p>
    </div>
    <div>
      <div class="text-3xl w-full font-bold mb-5 pt-10">Example Posts</div>
    </div>
    <div class="flex flex-row gap-3 flex-wrap justify-center items-start">
      <div class="w-[260px] h-[592px] overflow-hidden rounded-lg">
        <iframe
          class="block border-0"
          style="width: 325px; height: 740px; transform: scale(0.8); transform-origin: top left;"
          src="https://www.tiktok.com/embed/v2/7547716048544386334?lang=en-US"
          title="TikTok video 1"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        ></iframe>
      </div>

      <div class="w-[260px] h-[592px] overflow-hidden rounded-lg">
        <iframe
          class="block border-0"
          style="width: 325px; height: 740px; transform: scale(0.8); transform-origin: top left;"
          src="https://www.tiktok.com/embed/v2/7545844749446466847?lang=en-US"
          title="TikTok video 2"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        ></iframe>
      </div>

      <div class="w-[260px] h-[592px] overflow-hidden rounded-lg">
        <iframe
          class="block border-0"
          style="width: 325px; height: 740px; transform: scale(0.8); transform-origin: top left;"
          src="https://www.tiktok.com/embed/v2/7534728367535443231?lang=en-US"
          title="TikTok video 3"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        ></iframe>
      </div>
    </div>
  </div>
</BaseLayout>
